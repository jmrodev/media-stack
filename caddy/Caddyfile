{
    # Sin dominio real, sólo HTTP en :80 para el demo.
    auto_https off
    admin off
}

:80 {
    # === Apps CON UrlBase / APPLICATION_ROOT configurado ===
    # El proxy NO strippea el prefijo: la app sabe su base
    # y sirve las URLs internas con el prefijo incluido.

    @sonarr path /sonarr*
    handle @sonarr {
        reverse_proxy sonarr:8989
    }

    @radarr path /radarr*
    handle @radarr {
        reverse_proxy radarr:7878
    }

    @bazarr path /bazarr*
    handle @bazarr {
        reverse_proxy bazarr:6767
    }

    @jellyfin path /jellyfin*
    handle @jellyfin {
        reverse_proxy jellyfin:8096
    }

    # Wizarr custom de pablokbs con APPLICATION_ROOT=/wizarr.
    @wizarr path /wizarr*
    handle @wizarr {
        reverse_proxy wizarr:5690
    }

    # === Apps SIN soporte de subpath (strippeamos prefijo) ===

    # qBittorrent NO va por aca: se expone directo en :8080 del host
    # (ver el puerto en docker-compose.yml). No soporta subpath de forma
    # estable porque sus URLs internas son relativas y se rompen cuando
    # Caddy strippea el prefijo.

    # Jellyseerr (Seerr) NO va por aca: no soporta base URL y se expone
    # directo en :5055 del host. Ver docker-compose.yml.

    # Dashboard central (Homarr) en la raíz. También es el catch-all:
    # toda ruta que no matchee una app va a Homarr (es una SPA de Next.js
    # que redirige a /init o /login internamente).
    @homarr path /
    handle @homarr {
        reverse_proxy homarr:7575
    }

    # Health check
    handle /healthz {
        respond "ok"
    }

    # Catch-all: Homarr se encarga de todo lo que no es una app.
    handle {
        reverse_proxy homarr:7575
    }
}
